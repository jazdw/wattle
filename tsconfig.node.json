{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The server code is type-checked here too (against Node types) so it stays
  // free of Cloudflare-only APIs. Tests live next to the code they cover.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "node",
    "server",
    "shared",
    "test",
    "**/*.test.ts"
  ],
  "exclude": ["node_modules", "dist", "src/**/*.tsx"]
}
