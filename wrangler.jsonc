/**
 * Cloudflare Worker configuration for Wattle Wealth. Nothing in this file is
 * specific to one deployment:
 *  - database_id is a placeholder. `npm run deploy` finds the real database
 *    by name (creating it the first time; scripts/remote-d1.mjs) and builds
 *    with its id (see vite.config.ts). Local development doesn't need one.
 *  - The domain comes from CUSTOM_DOMAIN (a repository secret in CI).
 *  - Secrets are set on the Worker, so deploys never reset them:
 *      npx wrangler secret put <NAME>
 *    GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENC_KEY, PLAID_CLIENT_ID,
 *    PLAID_SECRET, TIINGO_API_KEY, FINNHUB_API_KEY.
 *  - Plain settings (PLAID_ENV, QUOTE_PROVIDER, …) are passed as variables
 *    on each deploy by scripts/deploy.mjs, from GitHub repository variables.
 *  - Who can sign in is kept in the allowed_emails table: npm run allow.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wattle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  // Served only from the custom domain, which is kept out of the repo: CI
  // deploys with `--domain` from the CUSTOM_DOMAIN Actions secret (see
  // .github/workflows/deploy.yml). Manually: npm run deploy -- --domain <host>
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // In SPA mode, browser navigations are answered with index.html before
    // the Worker runs. API routes that the browser navigates to (the Google
    // OAuth start and callback) must always reach the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wattle",
      "database_id": "00000000-0000-0000-0000-000000000000", // set at deploy time
      "migrations_dir": "migrations"
    }
  ],
  // Background jobs (server/services/jobRunner.ts): the jobs table is the
  // record; a message only says "run job <id>". One job per invocation, so
  // each has the Worker's limits to itself. `npm run deploy` creates the
  // queue if it doesn't exist.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "wattle-jobs" }],
    "consumers": [
      {
        "queue": "wattle-jobs",
        "max_batch_size": 1,
        // A few at once: enough to keep up, gentle on D1 and on Tiingo's 50 requests an hour.
        "max_concurrency": 3,
        // Jobs count their own attempts; this only covers deliveries that failed outright.
        "max_retries": 10
      }
    ]
  },
  // Daily snapshot: 02:00 UTC is after the US close (22:00 New York in
  // summer, 21:00 in winter), once end-of-day prices are published.
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
