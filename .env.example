# Copy this file to `.env.local` to configure local development.
# `.env.local` is gitignored, so it won't be committed.

# Which interface/IP the Vite dev server binds to.
#   localhost        only your machine (default)
#   192.168.1.182    your Wi-Fi IP, reachable from a phone on the same network
#   0.0.0.0          every interface
DEV_HOST=localhost
